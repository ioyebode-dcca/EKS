pipeline {

    agent any

    environment {
        AWS_REGION   = 'us-east-1'
        TF_DIR       = "environments/${params.ENVIRONMENT}"
        CLUSTER_NAME = "underwater-${params.ENVIRONMENT}"
    }

    options {
        skipStagesAfterUnstable()
        timestamps()
        buildDiscarder(logRotator(numToKeepStr: '10'))
        timeout(time: 90, unit: 'MINUTES')
    }

    parameters {
        choice(
            name: 'ACTION',
            choices: ['Plan', 'Apply', 'Destroy'],
            description: 'Terraform action to perform'
        )
        choice(
            name: 'ENVIRONMENT',
            choices: ['dev', 'prod'],
            description: 'Target environment'
        )
        string(
            name: 'K8S_VERSION',
            defaultValue: '',
            description: 'Kubernetes version to move to, for example 1.35. Leave blank to keep the running version (or the terraform.tfvars version for a new cluster). EKS upgrades one minor version at a time.'
        )
        string(
            name: 'ADDON_VERSIONS',
            defaultValue: '',
            description: 'Optional add-on pins as name=version,name=version. Example: coredns=v1.12.1-eksbuild.2. Leave blank to use the newest version compatible with the cluster. Names: vpc-cni, coredns, kube-proxy, eks-pod-identity-agent, aws-ebs-csi-driver.'
        )
    }

    stages {

        stage('Clean Workspace') {
            steps { cleanWs() }
        }

        stage('Checkout SCM') {
            steps {
                checkout scm
                script {
                    env.GIT_COMMIT_SHORT = sh(
                        returnStdout: true,
                        script: "git rev-parse --short HEAD"
                    ).trim()
                    echo "Branch: ${GIT_BRANCH} | Environment: ${params.ENVIRONMENT} | Action: ${params.ACTION}"
                }
            }
        }

        stage('Verify Tools') {
            steps {
                sh '''
                    echo "=== Checking tools ==="
                    terraform version
                    aws --version
                    kubectl version --client
                    aws sts get-caller-identity
                '''
            }
        }

        // Works out which Kubernetes version and add-on pins Terraform should
        // use, and blocks unsafe requests before any plan is made.
        stage('Resolve Versions') {
            steps {
                sh '''
                    set -e

                    CURRENT=$(aws eks describe-cluster --name "$CLUSTER_NAME" --region "$AWS_REGION" --query 'cluster.version' --output text 2>/dev/null || true)
                    REQUESTED=$(echo "${K8S_VERSION:-}" | tr -d ' ')

                    if [ -n "$REQUESTED" ] && ! echo "$REQUESTED" | grep -Eq '^1\\.[0-9]{2}$'; then
                        echo "ERROR: K8S_VERSION must look like 1.35. Got: $REQUESTED"
                        exit 1
                    fi

                    # Blank request means stay on the running version, so a
                    # routine Plan or Apply can never downgrade the cluster.
                    TARGET="${REQUESTED:-$CURRENT}"

                    echo "=== Version summary ==="
                    echo "Cluster:          $CLUSTER_NAME"
                    echo "Running version:  ${CURRENT:-none (cluster does not exist)}"
                    echo "Requested:        ${REQUESTED:-none}"
                    echo "Terraform target: ${TARGET:-from terraform.tfvars}"

                    if [ -n "$CURRENT" ] && [ -n "$TARGET" ]; then
                        CUR_MINOR=${CURRENT#1.}
                        TGT_MINOR=${TARGET#1.}
                        DIFF=$((TGT_MINOR - CUR_MINOR))
                        if [ "$DIFF" -lt 0 ]; then
                            echo "ERROR: EKS cannot downgrade from $CURRENT to $TARGET."
                            exit 1
                        fi
                        if [ "$DIFF" -gt 1 ]; then
                            echo "ERROR: EKS upgrades one minor version at a time. From $CURRENT the next step is 1.$((CUR_MINOR + 1))."
                            exit 1
                        fi
                        if [ "$DIFF" -eq 1 ]; then
                            echo "This run will UPGRADE the control plane from $CURRENT to $TARGET."
                        fi
                    fi

                    if [ -n "$TARGET" ]; then
                        echo "=== Newest add-on versions for Kubernetes $TARGET ==="
                        for ADDON in vpc-cni coredns kube-proxy eks-pod-identity-agent aws-ebs-csi-driver; do
                            LATEST=$(aws eks describe-addon-versions --kubernetes-version "$TARGET" --addon-name "$ADDON" --region "$AWS_REGION" --query 'addons[0].addonVersions[0].addonVersion' --output text 2>/dev/null || echo "unknown")
                            echo "$ADDON: $LATEST"
                            if [ "$ADDON" = "vpc-cni" ] && { [ "$LATEST" = "None" ] || [ "$LATEST" = "unknown" ]; }; then
                                echo "ERROR: EKS does not offer Kubernetes $TARGET in $AWS_REGION."
                                exit 1
                            fi
                        done
                    fi

                    ARGS=""
                    if [ -n "$TARGET" ]; then
                        ARGS="-var=cluster_version=$TARGET"
                    fi

                    PINS=$(echo "${ADDON_VERSIONS:-}" | tr -d ' ')
                    if [ -n "$PINS" ]; then
                        if ! echo "$PINS" | grep -Eq '^[a-z0-9-]+=[A-Za-z0-9.-]+(,[a-z0-9-]+=[A-Za-z0-9.-]+)*$'; then
                            echo "ERROR: ADDON_VERSIONS must look like name=version,name=version. Got: $PINS"
                            exit 1
                        fi
                        MAP=$(echo "$PINS" | sed -E 's/([^=,]+)=([^,]+)/"\\1"="\\2"/g')
                        ARGS="$ARGS -var=addon_versions={$MAP}"
                        echo "Add-on pins: $PINS"
                    else
                        echo "Add-on pins: none (newest compatible versions)"
                    fi

                    echo "$ARGS" > "$WORKSPACE/tf-version-args.txt"
                    echo "$TARGET" > "$WORKSPACE/target-k8s.txt"
                '''
                script {
                    env.TF_VERSION_ARGS = readFile('tf-version-args.txt').trim()
                    env.TARGET_K8S = readFile('target-k8s.txt').trim()
                }
            }
        }

        stage('Terraform Init') {
            steps {
                sh '''
                    cd "$TF_DIR"
                    terraform init -reconfigure
                    terraform validate
                '''
            }
        }

        stage('Terraform Plan') {
            steps {
                withCredentials([string(credentialsId: 'alert-phone-number', variable: 'PHONE_NUMBER')]) {
                    sh '''
                        cd "$TF_DIR"
                        terraform plan \
                          -input=false \
                          $TF_VERSION_ARGS \
                          -var="alert_phone_number=$PHONE_NUMBER" \
                          -out=tfplan
                        terraform show -no-color tfplan > tfplan.txt
                        echo "=== Plan Summary ==="
                        tail -5 tfplan.txt
                    '''
                    archiveArtifacts artifacts: "${TF_DIR}/tfplan.txt"
                }
            }
        }

        stage('Review Plan') {
            when {
                expression { params.ACTION == 'Apply' || params.ACTION == 'Destroy' }
            }
            steps {
                script {
                    def msg = params.ACTION == 'Destroy' \
                        ? "DESTROY ALL ${params.ENVIRONMENT} resources? This cannot be undone!" \
                        : "Apply Terraform plan to ${params.ENVIRONMENT}? Review tfplan.txt first."
                    input message: msg, ok: params.ACTION
                }
            }
        }

        stage('Terraform Apply') {
            when { expression { params.ACTION == 'Apply' } }
            steps {
                sh '''
                    cd "$TF_DIR"
                    terraform apply \
                      -input=false \
                      tfplan
                '''
            }
        }

        // Confirms the cluster landed on the expected version, nodes are
        // Ready, and every add-on is healthy.
        stage('Validate Cluster') {
            when { expression { params.ACTION == 'Apply' } }
            steps {
                sh '''
                    set -e

                    aws eks update-kubeconfig --region "$AWS_REGION" --name "$CLUSTER_NAME"

                    ACTUAL=$(aws eks describe-cluster --name "$CLUSTER_NAME" --region "$AWS_REGION" --query 'cluster.version' --output text)
                    echo "=== Control plane version: $ACTUAL ==="
                    if [ -n "$TARGET_K8S" ] && [ "$ACTUAL" != "$TARGET_K8S" ]; then
                        echo "ERROR: expected Kubernetes $TARGET_K8S but the cluster reports $ACTUAL."
                        exit 1
                    fi

                    echo "=== Waiting for nodes to be Ready ==="
                    kubectl wait --for=condition=Ready nodes --all --timeout=600s
                    kubectl get nodes -o wide

                    echo "=== Add-ons ==="
                    FAILED=0
                    for ADDON in $(aws eks list-addons --cluster-name "$CLUSTER_NAME" --region "$AWS_REGION" --query 'addons[]' --output text); do
                        INFO=$(aws eks describe-addon --cluster-name "$CLUSTER_NAME" --addon-name "$ADDON" --region "$AWS_REGION" --query 'addon.[addonName,addonVersion,status]' --output text)
                        echo "$INFO"
                        case "$INFO" in
                            *ACTIVE) ;;
                            *) FAILED=1 ;;
                        esac
                    done
                    if [ "$FAILED" -ne 0 ]; then
                        echo "ERROR: one or more add-ons are not ACTIVE."
                        exit 1
                    fi
                '''
            }
        }

        stage('Cleanup Kubernetes Resources') {
            when { expression { params.ACTION == 'Destroy' } }
            steps {
                sh """
                    echo "=== Checking if cluster exists ==="
                    CLUSTER_EXISTS=\$(aws eks describe-cluster \
                      --name ${CLUSTER_NAME} \
                      --region ${AWS_REGION} \
                      --query 'cluster.status' \
                      --output text 2>/dev/null || echo "NOT_FOUND")

                    if [ "\$CLUSTER_EXISTS" = "NOT_FOUND" ]; then
                        echo "Cluster ${CLUSTER_NAME} not found. Skipping Kubernetes cleanup."
                        exit 0
                    fi

                    echo "=== Connecting to cluster ==="
                    aws eks update-kubeconfig \
                      --region ${AWS_REGION} \
                      --name ${CLUSTER_NAME}

                    echo "=== Removing ingress-nginx (deletes NLB) ==="
                    helm uninstall ingress-nginx -n ingress-nginx || true
                    kubectl delete namespace ingress-nginx --ignore-not-found=true

                    echo "=== Removing monitoring stack (deletes EBS volumes) ==="
                    helm uninstall prometheus -n monitoring || true
                    kubectl delete namespace monitoring --ignore-not-found=true

                    echo "=== Waiting 90s for AWS to fully delete NLB and EBS volumes ==="
                    sleep 90

                    echo "=== Verifying NLB is gone ==="
                    aws elbv2 describe-load-balancers \
                      --region ${AWS_REGION} \
                      --query 'LoadBalancers[*].[LoadBalancerName,State.Code]' \
                      --output table || true
                """
            }
        }

        stage('Terraform Destroy') {
            when { expression { params.ACTION == 'Destroy' } }
            steps {
                withCredentials([string(credentialsId: 'alert-phone-number', variable: 'PHONE_NUMBER')]) {
                    sh '''
                        cd "$TF_DIR"
                        terraform init -reconfigure
                        terraform destroy \
                          -auto-approve \
                          $TF_VERSION_ARGS \
                          -var="alert_phone_number=$PHONE_NUMBER"
                    '''
                }
            }
        }
    }

    post {
        success {
            echo "SUCCESS: ${params.ACTION} on ${params.ENVIRONMENT} completed"
        }
        failure {
            echo "FAILED: ${params.ACTION} on ${params.ENVIRONMENT} failed"
        }
        always {
            archiveArtifacts artifacts: '**/tfplan.txt', allowEmptyArchive: true
            cleanWs()
        }
    }
}
