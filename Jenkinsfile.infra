pipeline {

    agent any

    environment {
        AWS_REGION   = 'us-east-1'
        TF_DIR       = "environments/${params.ENVIRONMENT}"
        CLUSTER_NAME = "underwater-${params.ENVIRONMENT}"
    }

    options {
        skipStagesAfterUnstable()
        timestamps()
        buildDiscarder(logRotator(numToKeepStr: '10'))
        timeout(time: 60, unit: 'MINUTES')
    }

    parameters {
        choice(
            name: 'ACTION',
            choices: ['Plan', 'Apply', 'Destroy'],
            description: 'Terraform action to perform'
        )
        choice(
            name: 'ENVIRONMENT',
            choices: ['dev', 'prod'],
            description: 'Target environment'
        )
    }

    stages {

        stage('Clean Workspace') {
            steps { cleanWs() }
        }

        stage('Checkout SCM') {
            steps {
                checkout scm
                script {
                    env.GIT_COMMIT_SHORT = sh(
                        returnStdout: true,
                        script: "git rev-parse --short HEAD"
                    ).trim()
                    echo "Branch: ${GIT_BRANCH} | Environment: ${params.ENVIRONMENT} | Action: ${params.ACTION}"
                }
            }
        }

        stage('Verify Tools') {
            steps {
                sh '''
                    echo "=== Checking tools ==="
                    terraform version
                    aws --version
                    aws sts get-caller-identity
                '''
            }
        }

        stage('Terraform Init') {
            steps {
                sh """
                    cd ${TF_DIR}
                    terraform init -reconfigure
                    terraform validate
                """
            }
        }

        stage('Terraform Plan') {
            steps {
                withCredentials([string(credentialsId: 'alert-phone-number', variable: 'PHONE_NUMBER')]) {
                    sh """
                        cd ${TF_DIR}
                        terraform plan \
                          -input=false \
                          -var="alert_phone_number=${PHONE_NUMBER}" \
                          -out=tfplan
                        terraform show -no-color tfplan > tfplan.txt
                        echo "=== Plan Summary ==="
                        tail -5 tfplan.txt
                    """
                    archiveArtifacts artifacts: "${TF_DIR}/tfplan.txt"
                }
            }
        }

        stage('Review Plan') {
            when {
                expression { params.ACTION == 'Apply' || params.ACTION == 'Destroy' }
            }
            steps {
                script {
                    def msg = params.ACTION == 'Destroy' \
                        ? "DESTROY ALL ${params.ENVIRONMENT} resources? This cannot be undone!" \
                        : "Apply Terraform plan to ${params.ENVIRONMENT}? Review tfplan.txt first."
                    input message: msg, ok: params.ACTION
                }
            }
        }

        stage('Terraform Apply') {
            when { expression { params.ACTION == 'Apply' } }
            steps {
                withCredentials([string(credentialsId: 'alert-phone-number', variable: 'PHONE_NUMBER')]) {
                    sh """
                        cd ${TF_DIR}
                        terraform apply \
                          -input=false \
                          tfplan
                    """
                }
            }
        }

        stage('Update kubeconfig') {
            when { expression { params.ACTION == 'Apply' } }
            steps {
                sh """
                    aws eks update-kubeconfig \
                      --region ${AWS_REGION} \
                      --name ${CLUSTER_NAME}

                    echo "=== Cluster Nodes ==="
                    kubectl get nodes
                """
            }
        }

        stage('Cleanup Kubernetes Resources') {
            when { expression { params.ACTION == 'Destroy' } }
            steps {
                sh """
                    echo "=== Checking if cluster exists ==="
                    CLUSTER_EXISTS=\$(aws eks describe-cluster \
                      --name ${CLUSTER_NAME} \
                      --region ${AWS_REGION} \
                      --query 'cluster.status' \
                      --output text 2>/dev/null || echo "NOT_FOUND")

                    if [ "\$CLUSTER_EXISTS" = "NOT_FOUND" ]; then
                        echo "Cluster ${CLUSTER_NAME} not found — skipping Kubernetes cleanup"
                        exit 0
                    fi

                    echo "=== Connecting to cluster ==="
                    aws eks update-kubeconfig \
                      --region ${AWS_REGION} \
                      --name ${CLUSTER_NAME}

                    echo "=== Removing ingress-nginx (deletes NLB) ==="
                    helm uninstall ingress-nginx -n ingress-nginx || true
                    kubectl delete namespace ingress-nginx --ignore-not-found=true

                    echo "=== Removing monitoring stack (deletes EBS volumes) ==="
                    helm uninstall prometheus -n monitoring || true
                    kubectl delete namespace monitoring --ignore-not-found=true

                    echo "=== Waiting 90s for AWS to fully delete NLB and EBS volumes ==="
                    sleep 90

                    echo "=== Verifying NLB is gone ==="
                    aws elbv2 describe-load-balancers \
                      --region ${AWS_REGION} \
                      --query 'LoadBalancers[*].[LoadBalancerName,State.Code]' \
                      --output table || true
                """
            }
        }

        stage('Terraform Destroy') {
            when { expression { params.ACTION == 'Destroy' } }
            steps {
                withCredentials([string(credentialsId: 'alert-phone-number', variable: 'PHONE_NUMBER')]) {
                    sh """
                        cd ${TF_DIR}
                        terraform init -reconfigure
                        terraform destroy \
                          -auto-approve \
                          -var="alert_phone_number=${PHONE_NUMBER}"
                    """
                }
            }
        }
    }

    post {
        success {
            echo "SUCCESS: ${params.ACTION} on ${params.ENVIRONMENT} completed"
        }
        failure {
            echo "FAILED: ${params.ACTION} on ${params.ENVIRONMENT} failed"
        }
        always {
            archiveArtifacts artifacts: '**/tfplan.txt', allowEmptyArchive: true
            cleanWs()
        }
    }
}